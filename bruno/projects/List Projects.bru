meta {
  name: List Projects
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/projects?page=1&pageSize=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.status === 200 && res.body?.data?.length) {
    bru.setEnvVar("projectId", res.body.data[0].id);
  }
}
