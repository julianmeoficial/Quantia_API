{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/setup-e2e.ts"],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@quantia/contracts$": "<rootDir>/../packages/contracts/src/index.ts",
    "^@nestjs/bullmq$": "<rootDir>/mocks/nestjs-bullmq.ts",
    "^bullmq$": "<rootDir>/mocks/bullmq.ts"
  },
  "maxWorkers": 1,
  "forceExit": true,
  "testTimeout": 15000
}
