NODE_ENV=development
# Deploy policy: development | test | staging | production (independent of NODE_ENV)
APP_ENV=development
# Railway injects PORT; local default 3000
PORT=3000
# App traffic: local Compose uses postgres:5432.
# Staging/prod: Supabase Transaction pooler :6543 + ?pgbouncer=true
DATABASE_URL=postgresql://quantia:quantia@postgres:5432/quantia
# Migrations only. Never point the Nest app pool at DIRECT_URL.
# Staging (IPv4 / no Direct AAAA): Session pooler :5432 on *.pooler.supabase.com
#   (official staging policy — ENG-156). Prefer Direct db.*:5432 only when IPv6 works.
# Local Compose: same host as DATABASE_URL.
DIRECT_URL=postgresql://quantia:quantia@postgres:5432/quantia
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=quantia-dev-access-secret-change-me-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=quantia-dev-refresh-secret-change-me-32
JWT_REFRESH_TTL=7d
JWT_ISSUER=quantia-api
JWT_AUDIENCE=quantia-clients
# Comma-separated allowlist for HTTP + Socket.io (never *)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Staging: true so https://*.vercel.app previews can call the API
# Forbidden when APP_ENV=production (validated at boot)
CORS_VERCEL_PREVIEW=false
# Trial RAM guard (Railway api + worker). Omit locally if you prefer.
# NODE_OPTIONS=--max-old-space-size=350

# Notion — sandbox F3 (replace secrets; IDs are public sandbox values)
NOTION_TOKEN=ntn_replace_me
# Same value as verification_token from Notion webhook handshake (HMAC key). NOT the integration access token.
# Staging rotate: Notion Resend → Railway Quantia_API Console → cat /tmp/notion-verify-token.txt → paste here + Verify UI.
NOTION_WEBHOOK_SECRET=secret_replace_me_verification_token
NOTION_VERSION=2025-09-03
NOTION_RATE_LIMIT_RPS=3
NOTION_SYNC_MAX_ATTEMPTS=5
# Reject webhooks whose timestamp skew exceeds this (seconds); also Redis replay TTL
NOTION_WEBHOOK_MAX_SKEW_SECONDS=300
NOTION_SANDBOX_PAGE_ID=3df8b2d8-659c-808d-890f-d25b0213aacd
NOTION_DB_USERS=182336f1-ce31-4495-bd88-f168bf3aa3bc
NOTION_DS_USERS=6a429964-8f61-43c9-952d-1e68fb3e578c
NOTION_DB_PROJECTS=5c857af6-f89c-41a4-9ed6-e59af6a53454
NOTION_DS_PROJECTS=f34435f4-95c6-4e98-b808-c2cc93a563ca
NOTION_DB_TASKS=9d0bd14e-6be8-4f99-9de6-8375f8600770
NOTION_DS_TASKS=f5f6ecfa-e866-4234-b481-19849da9944f
NOTION_DB_PROGRESS=950366a7-30f3-4f00-9094-a2d1af9209d9
NOTION_DS_PROGRESS=59238cc9-6691-414e-af53-bcd9648e9897
NOTION_DB_SYNC_LOG=a1c62fe1-d457-4a7d-b16a-c360786b7520
NOTION_DS_SYNC_LOG=f3e4e43d-185a-41c2-9eb9-7bf8303892b8

# Supabase Storage (F5) — private buckets only; never commit real service_role
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me_service_role
SUPABASE_STORAGE_BUCKET_DOCUMENTS=quantia-documents
SUPABASE_STORAGE_BUCKET_REPORTS=quantia-reports
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=26214400
STORAGE_ALLOWED_MIME=application/pdf,image/png,image/jpeg,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# S5 / ENG-131 — throttling, quotas, WS limits, alert thresholds
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_REPORTS_TTL_MS=60000
THROTTLE_REPORTS_LIMIT=5
HTTP_JSON_BODY_LIMIT=1mb
HTTP_JSON_MAX_DEPTH=10
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_EVENTS_PER_SECOND=30
WS_IDLE_TIMEOUT_MS=60000
SECURITY_ALERT_401_403_THRESHOLD=50

# ENG-171 — Chat General del semillero (defaults keep deploy safe when unset)
CHAT_GENERAL_ENABLED=true
CHAT_GENERAL_ROOM=general
CHAT_GENERAL_HISTORY_DEFAULT_LIMIT=30
CHAT_GENERAL_HISTORY_MAX_LIMIT=100
CHAT_GENERAL_MESSAGE_MAX_LENGTH=2000
CHAT_GENERAL_PRESENCE_TTL_SECONDS=60
CHAT_GENERAL_HEARTBEAT_SECONDS=20
CHAT_GENERAL_RATE_LIMIT=20
