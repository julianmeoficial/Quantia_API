generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  INVESTIGADOR
  COORDINADOR
  ADMINISTRADOR
}

enum ProjectStatus {
  FORMULATION
  ACTIVE
  DELAYED
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum SyncDirection {
  NOTION_TO_DB
  DB_TO_NOTION
}

enum SyncEntityType {
  USER
  PROJECT
  TASK
  PROGRESS
}

enum SyncJobName {
  NOTION_TO_DB
  DB_TO_NOTION
}

enum SyncEventStatus {
  QUEUED
  PROCESSING
  SYNCED
  PENDING
  FAILED
  DUPLICATE
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      RoleName @unique
  createdAt DateTime @default(now()) @map("created_at")

  userRoles UserRole[]

  @@map("roles")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  email          String     @unique
  passwordHash   String     @map("password_hash")
  fullName       String     @map("full_name")
  isActive       Boolean    @default(true) @map("is_active")
  notionPageId   String?    @unique @map("notion_page_id")
  lastEditedTime DateTime?  @map("last_edited_time")
  syncedAt       DateTime?  @map("synced_at")
  syncStatus     SyncStatus @default(PENDING) @map("sync_status")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  userRoles           UserRole[]
  refreshTokens       RefreshToken[]
  coordinatedProjects Project[]       @relation("ProjectCoordinator")
  createdProjects     Project[]       @relation("ProjectCreator")
  projectMemberships  ProjectMember[]
  assignedTasks       Task[]          @relation("TaskAssignee")
  progressEntries     Progress[]
  budgetExecutions    BudgetExecution[]
  uploadedDocuments   Document[]      @relation("DocumentUploader")
  requestedReports    Report[]        @relation("ReportRequester")
  auditLogs           AuditLog[]

  @@map("users")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  objectives      String?
  status          ProjectStatus @default(FORMULATION)
  startDate       DateTime?     @map("start_date")
  endDate         DateTime?     @map("end_date")
  coordinatorId   String        @map("coordinator_id") @db.Uuid
  createdById     String        @map("created_by_id") @db.Uuid
  notionPageId    String?       @unique @map("notion_page_id")
  lastEditedTime  DateTime?     @map("last_edited_time")
  syncedAt        DateTime?     @map("synced_at")
  syncStatus      SyncStatus    @default(PENDING) @map("sync_status")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  coordinator User           @relation("ProjectCoordinator", fields: [coordinatorId], references: [id])
  createdBy   User           @relation("ProjectCreator", fields: [createdById], references: [id])
  members     ProjectMember[]
  tasks       Task[]
  progress    Progress[]
  budget      Budget?
  documents   Document[]
  reports     Report[]

  @@index([coordinatorId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  title          String
  description    String?
  assigneeId     String?      @map("assignee_id") @db.Uuid
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?    @map("due_date")
  notionPageId   String?      @unique @map("notion_page_id")
  lastEditedTime DateTime?    @map("last_edited_time")
  syncedAt       DateTime?    @map("synced_at")
  syncStatus     SyncStatus   @default(PENDING) @map("sync_status")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  progress Progress[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@map("tasks")
}

model Progress {
  id             String     @id @default(uuid()) @db.Uuid
  projectId      String     @map("project_id") @db.Uuid
  taskId         String?    @map("task_id") @db.Uuid
  authorId       String     @map("author_id") @db.Uuid
  title          String
  description    String
  evidenceLinks  String[]   @default([]) @map("evidence_links")
  recordedAt     DateTime   @default(now()) @map("recorded_at")
  notionPageId   String?    @unique @map("notion_page_id")
  lastEditedTime DateTime?  @map("last_edited_time")
  syncedAt       DateTime?  @map("synced_at")
  syncStatus     SyncStatus @default(PENDING) @map("sync_status")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([taskId])
  @@index([authorId])
  @@map("progress_entries")
}

model SyncEvent {
  id                    String          @id @default(uuid()) @db.Uuid
  direction             SyncDirection
  entityType            SyncEntityType  @map("entity_type")
  jobName               SyncJobName     @map("job_name")
  notionPageId          String?         @map("notion_page_id")
  entityId              String?         @map("entity_id") @db.Uuid
  status                SyncEventStatus @default(QUEUED)
  attempts              Int             @default(0)
  errorMessage          String?         @map("error_message")
  payloadLastEditedTime DateTime?       @map("payload_last_edited_time")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  @@index([notionPageId])
  @@index([status])
  @@index([entityType, entityId])
  @@map("sync_events")
}

enum BudgetExecutionKind {
  COMMITMENT
  PAYMENT
  ADJUSTMENT
}

enum DocumentStatus {
  UPLOADED
  SCANNED
  QUARANTINED
}

enum ReportKind {
  BUDGET_PDF
  BUDGET_EXCEL
  PROGRESS_PDF
}

enum ReportStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum AuditResult {
  SUCCESS
  DENIED
  ERROR
}

model Budget {
  id                    String   @id @default(uuid()) @db.Uuid
  projectId             String   @unique @map("project_id") @db.Uuid
  totalAmount           Decimal  @map("total_amount") @db.Decimal(14, 2)
  currency              String   @default("COP") @db.Char(3)
  alertThresholdPercent Int      @default(80) @map("alert_threshold_percent")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items      BudgetItem[]
  executions BudgetExecution[]

  @@map("budgets")
}

model BudgetItem {
  id            String   @id @default(uuid()) @db.Uuid
  budgetId      String   @map("budget_id") @db.Uuid
  category      String
  plannedAmount Decimal  @map("planned_amount") @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  budget     Budget            @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  executions BudgetExecution[]

  @@index([budgetId])
  @@map("budget_items")
}

model BudgetExecution {
  id            String              @id @default(uuid()) @db.Uuid
  budgetId      String              @map("budget_id") @db.Uuid
  itemId        String?             @map("item_id") @db.Uuid
  kind          BudgetExecutionKind
  amount        Decimal             @db.Decimal(14, 2)
  occurredAt    DateTime            @map("occurred_at")
  registeredById String             @map("registered_by_id") @db.Uuid
  note          String?
  createdAt     DateTime            @default(now()) @map("created_at")

  budget       Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  item         BudgetItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  registeredBy User        @relation(fields: [registeredById], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([itemId])
  @@index([registeredById])
  @@map("budget_executions")
}

model Document {
  id            String         @id @default(uuid()) @db.Uuid
  projectId     String         @map("project_id") @db.Uuid
  uploadedById  String         @map("uploaded_by_id") @db.Uuid
  storageBucket String         @map("storage_bucket")
  storageKey    String         @map("storage_key")
  originalName  String         @map("original_name")
  mimeType      String         @map("mime_type")
  sizeBytes     Int            @map("size_bytes")
  status        DocumentStatus @default(UPLOADED)
  createdAt     DateTime       @default(now()) @map("created_at")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@unique([storageBucket, storageKey])
  @@index([projectId])
  @@index([uploadedById])
  @@map("documents")
}

model Report {
  id            String       @id @default(uuid()) @db.Uuid
  projectId     String       @map("project_id") @db.Uuid
  requestedById String       @map("requested_by_id") @db.Uuid
  kind          ReportKind
  status        ReportStatus @default(QUEUED)
  jobId         String?      @map("job_id")
  storageBucket String?      @map("storage_bucket")
  storageKey    String?      @map("storage_key")
  errorMessage  String?      @map("error_message")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("ReportRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([requestedById])
  @@index([status])
  @@map("reports")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  action     String
  resource   String
  resourceId String?     @map("resource_id")
  result     AuditResult
  ip         String?
  userAgent  String?     @map("user_agent")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
