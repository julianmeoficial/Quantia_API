  "info": {
    "title": "Quantia API",
    "description": "Research project management API (INNOVATEK'S / GITEMOS). Handoff artifact for Security / pentest (ENG-126).",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@quantia.local"
          },
          "password": {
            "type": "string",
            "example": "AdminPass1!",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@quantia.local"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "fullName": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "INVESTIGADOR",
                "COORDINADOR",
                "ADMINISTRADOR"
              ]
            }
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "password",
          "fullName",
          "roles"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "fullName": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "INVESTIGADOR",
                "COORDINADOR",
                "ADMINISTRADOR"
              ]
            }
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "objectives": {
            "type": "string",
            "maxLength": 5000
          },
          "status": {
            "type": "string",
            "enum": [
              "FORMULATION",
              "ACTIVE",
              "DELAYED",
              "COMPLETED",
              "CANCELLED"
            ]
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "coordinatorId": {
            "type": "string",
            "format": "uuid"
          },
          "memberIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "title"
        ]
      },
      "UpdateProjectDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "objectives": {
            "type": "string",
            "maxLength": 5000
          },
          "status": {
            "type": "string",
            "enum": [
              "FORMULATION",
              "ACTIVE",
              "DELAYED",
              "COMPLETED",
              "CANCELLED"
            ]
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "coordinatorId": {
            "type": "string",
            "format": "uuid"
          },
          "memberIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "AddProjectMemberDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "userId"
        ]
      },
      "CreateTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "assigneeId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "TODO",
              "IN_PROGRESS",
              "BLOCKED",
              "DONE"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "title"
        ]
      },
      "UpdateTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "assigneeId": {
            "type": "object",
            "format": "uuid",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "TODO",
              "IN_PROGRESS",
              "BLOCKED",
              "DONE"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "dueDate": {
            "type": "object",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "CreateProgressDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "taskId": {
            "type": "string",
            "format": "uuid"
          },
          "evidenceLinks": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "title",
          "description"
        ]
      },
      "UpdateProgressDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "taskId": {
            "type": "object",
            "format": "uuid",
            "nullable": true
          },
          "evidenceLinks": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BudgetItemInputDto": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "plannedAmount": {
            "type": "string",
            "example": "1000.00"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "category",
          "plannedAmount"
        ]
      },
      "CreateBudgetDto": {
        "type": "object",
        "properties": {
          "totalAmount": {
            "type": "string",
            "example": "10000.00"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "default": "COP"
          },
          "alertThresholdPercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "default": 80
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BudgetItemInputDto"
            }
          }
        },
        "required": [
          "totalAmount"
        ]
      },
      "UpdateBudgetDto": {
        "type": "object",
        "properties": {
          "totalAmount": {
            "type": "string",
            "example": "10000.00"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "alertThresholdPercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BudgetItemInputDto"
            }
          }
        }
      },
      "CreateBudgetExecutionDto": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "COMMITMENT",
              "PAYMENT",
              "ADJUSTMENT"
            ]
          },
          "amount": {
            "type": "string",
            "example": "250.00"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "kind",
          "amount"
        ]
      },
      "CreateReportDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "BUDGET_PDF",
              "BUDGET_EXCEL",
              "PROGRESS_PDF"
            ]
          }
        },
        "required": [
          "kind"
        ]
      }
    }
  }
